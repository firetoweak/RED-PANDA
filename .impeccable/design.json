  "components": [
    {
      "name": "新建 Bot",
      "kind": "button",
      "refersTo": "button-new-bot-light",
      "description": "侧栏第一操作；随宿主主题继承 CSS 变量。",
      "html": "<button class=\"ds-new ds-focus\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>新建 Bot</button>",
      "css": ".ds-new{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;height:40px;padding:0 12px;border:1px solid var(--rp-border);border-radius:6px;background:var(--rp-canvas);color:var(--mantine-color-text);font-family:\"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"PingFang SC\", sans-serif;font-size:13px;font-weight:600;line-height:1;cursor:pointer}.ds-new svg{color:var(--rp-accent-text)}.ds-new:hover:not(:disabled){background:var(--mantine-color-default-hover,var(--rp-hover))}.ds-new:disabled{cursor:not-allowed;background:var(--mantine-color-disabled);color:var(--mantine-color-disabled-color)}.ds-focus:focus-visible{outline:2px solid var(--identity-blue);outline-offset:3px}"
    },
    {
      "name": "群聊发送",
      "kind": "button",
      "refersTo": "button-send-light",
      "description": "群聊 30px 图标按钮；有内容且可发送时反转前景。",
      "html": "<button class=\"ds-send ds-focus\" aria-label=\"发送到群\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 14 21 3M21 3l-7 18-4-7-7-4 18-7\"/></svg></button>",
      "css": ".ds-send{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;border:0;border-radius:20px;background:var(--mantine-color-text);color:var(--rp-canvas);cursor:pointer}.ds-send:hover:not(:disabled){background:var(--mantine-color-text)}.ds-send:disabled{background:var(--mantine-color-disabled);color:var(--mantine-color-disabled-color);cursor:not-allowed}.ds-focus:focus-visible{outline:2px solid var(--identity-blue);outline-offset:3px}"
    },
    {
      "name": "搜索",
      "kind": "input",
      "refersTo": "input-search-light",
      "description": "36px 搜索输入；占位文字显式不透明。",
      "html": "<input class=\"ds-search ds-focus\" aria-label=\"搜索 Bot 或群聊\" placeholder=\"搜索 Bot 或群聊\" />",
      "css": ".ds-search{height:36px;width:100%;padding:0 12px;border:1px solid var(--rp-border-strong);border-radius:8px;background:var(--rp-canvas);color:var(--mantine-color-text);font-family:\"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"PingFang SC\", sans-serif;font-size:12px}.ds-search::placeholder{color:var(--rp-placeholder);opacity:1}.ds-search:focus{border-color:var(--mantine-primary-color-filled,var(--rp-accent-ring))}.ds-focus:focus-visible{outline:2px solid var(--identity-blue);outline-offset:3px}"
    },
    {
      "name": "名册行",
      "kind": "nav",
      "refersTo": "navigation-row-light",
      "description": "hover / focus-within 薄层、aria-current 选中底色。",
      "html": "<a class=\"ds-roster ds-focus\" href=\"#atlas\" aria-current=\"page\"><span class=\"ds-avatar\">A</span><span>Atlas</span></a>",
      "css": ".ds-roster{display:flex;align-items:center;gap:10px;min-height:52px;padding:8px;border-radius:10px;color:var(--mantine-color-text);background:transparent;font-family:\"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"PingFang SC\", sans-serif;font-size:13px;text-decoration:none}.ds-roster:hover,.ds-roster:focus-within{background:var(--rp-hover)}.ds-roster[aria-current=\"page\"]{background:var(--rp-tile)}.ds-avatar{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:9px;background:var(--identity-blue-bg);color:var(--identity-blue);font-size:15px;font-weight:600}.ds-focus:focus-visible{outline:2px solid var(--identity-blue);outline-offset:3px}"
    },
    {
      "name": "正文点名",
      "kind": "chip",
      "refersTo": "mention-atlas-light",
      "description": "非按钮的 inline 身份色标签，无新增 hover 语义。",
      "html": "<span class=\"ds-mention\">@Atlas</span>",
      "css": ".ds-mention{display:inline;padding:3px 5px;border-radius:4px;white-space:nowrap;background:var(--identity-blue-bg);color:var(--identity-blue);font-family:\"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"PingFang SC\", sans-serif;font-size:.93em}"
    },
    {
      "name": "Bot 气泡",
      "kind": "card",
      "refersTo": "message-bot-light",
      "description": "浅底、无描边无投影、随内容收缩的正文容器。",
      "html": "<article class=\"ds-bot\"><strong class=\"ds-author\">Atlas</strong><p>先确认目标，再把进展交代清楚。</p><pre><code>const ready = true;</code></pre></article>",
      "css": ".ds-bot{width:fit-content;max-width:min(calc(100% - 84px),calc(72ch + 32px));min-width:0;padding:12px 16px 15px;border-radius:10px;background:var(--rp-surface);color:var(--mantine-color-text);font-family:\"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"PingFang SC\", sans-serif;font-size:15px}.ds-author{color:var(--identity-blue);font-size:12px;line-height:1.5;font-weight:600}.ds-bot p{line-height:1.85}.ds-bot pre{max-width:100%;overflow-x:auto;white-space:pre;font:12px/1.65 \"JetBrains Mono\", \"Cascadia Code\", Consolas, monospace}@media(max-width:48em){.ds-bot{max-width:calc(100% - 51px);padding:10px 12px 12px;font-size:14px}}"
    },
    {
      "name": "人类气泡",
      "kind": "card",
      "refersTo": "message-human-light",
      "description": "整块消息靠右，气泡内仍然左对齐。",
      "html": "<div class=\"ds-human-row\"><span class=\"ds-human-avatar\">你</span><article class=\"ds-human\"><p>按这个方向继续。</p></article></div>",
      "css": ".ds-human-row{display:flex;flex-direction:row-reverse;align-items:flex-start;gap:12px;width:100%;font-family:\"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"PingFang SC\", sans-serif;font-size:15px}.ds-human-avatar{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;width:34px;height:34px;border-radius:9px;background:var(--rp-tile);color:var(--mantine-color-dimmed);font-size:13px;font-weight:600}.ds-human{width:fit-content;max-width:min(calc(100% - 84px),calc(72ch + 32px));min-width:0;padding:12px 16px 15px;border-radius:10px;background:var(--rp-bubble);color:var(--mantine-color-text);text-align:left}.ds-human p{margin:0;line-height:1.85}@media(max-width:48em){.ds-human-row{gap:8px;font-size:14px}.ds-human{max-width:calc(100% - 51px);padding:10px 12px 12px}.ds-human-avatar{width:27px;height:27px;border-radius:7px;font-size:12px}}"
    },
    {
      "name": "群聊输入",
      "kind": "input",
      "refersTo": "composer-group-light",
      "description": "紧凑 textarea；focus-within 只加强边框。",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-focus\" rows=\"1\" aria-label=\"群消息\" placeholder=\"发送到群聊，输入 @ 点名…\"></textarea></div>",
      "css": ".ds-composer{display:flex;flex-direction:column;gap:0;box-shadow:0 3px 12px #202e4510;width:min(820px,100%);padding:0;border:1px solid var(--rp-border-strong);border-radius:10px;background:var(--rp-composer);color:var(--mantine-color-text)}.ds-composer:focus-within{border-color:var(--rp-composer-focus);box-shadow:0 0 0 2px #8b9bb00c}.ds-composer textarea{width:100%;min-height:34px;padding:9px 14px 0;border:0;resize:none;background:transparent;color:inherit;caret-color:var(--identity-blue);font-family:\"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"PingFang SC\", sans-serif;font-size:13px;line-height:1.7}.ds-composer textarea::placeholder{color:var(--rp-placeholder);opacity:1}.ds-focus:focus-visible{outline:2px solid var(--identity-blue);outline-offset:3px}"
    },
    {
      "name": "消息引用",
      "kind": "custom",
      "description": "原作者与单行简短预览；点击回到原消息。",
      "html": "<div class=\"ds-quote\"><button class=\"ds-focus\" type=\"button\" aria-label=\"查看 Mori 的原消息\"><strong>Mori</strong><span>交接需要说明已完成、下一步与待决定的问题。</span></button></div>",
      "css": ".ds-quote{display:flex;align-items:flex-start;gap:6px;min-width:0;margin:4px 0 10px;padding:8px 10px;border-left:1px solid var(--rp-border-strong);border-radius:0 5px 5px 0;background:var(--rp-hover);font-family:\"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"PingFang SC\", sans-serif;font-size:12px}.ds-quote button{flex:1;min-width:0;padding:0;border:0;background:none;color:var(--mantine-color-dimmed);font:inherit;text-align:left;cursor:pointer;display:flex;align-items:center;gap:8px}.ds-quote strong{flex-shrink:0;margin:0;color:var(--identity-amber);font-size:12px}.ds-quote span{display:block;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ds-quote button:hover span{color:var(--mantine-color-text)}.ds-focus:focus-visible{outline:2px solid var(--identity-blue);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "轻盈协作",
    "overview": "以用户已选定的「轻盈协作」为视觉北极星：白色与中性炭灰承托对话，浅气泡区分消息，身份色帮助在长报告中找到同事。界面克制、清楚，保留正文的阅读节奏。\n\n当前实现使用本机中文无衬线字体、细线 SVG 图标、小圆角与轻边界。明暗主题共用布局和身份关系；陶土色出现在部分操作与定位状态，蓝色承担全局键盘焦点和文字选择。",
    "keyCharacteristics": [
      "明暗共用的灰阶聊天工作面",
      "头像、署名与点名保持同一身份色",
      "浅气泡、完整正文、气泡内代码滚动",
      "系统中文字体与宽松正文行距"
    ],
    "rules": [
      {
        "name": "Identity Continuity",
        "body": "同一 Bot 的头像、署名与正文点名使用同一身份色；Atlas 蓝、Nova 紫、Echo 绿、Mori 琥珀不随主题交换。",
        "section": "colors"
      },
      {
        "name": "One Bubble Measure",
        "body": "长消息的整块气泡受正文行宽与可用空间共同限制；不要让代码或 diff 扩大整块底色。",
        "section": "typography"
      },
      {
        "name": "Flat Reading Surface",
        "body": "静态气泡保持无描边、无投影；阴影按实际组件逐项记录，不推导成所有容器通用的浮卡样式。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 让身份色贯穿同一 Bot 的头像、署名和点名。",
      "Do 让整个人类气泡靠右、Bot 气泡靠左，气泡里的正文保持左对齐。",
      "Do 保持两套主题的占位文字显式着色且 opacity 为 1。",
      "Do 让代码与表格在气泡内部横向滚动，并保留明显的键盘焦点。"
    ],
    "donts": [
      "Don't 把人类消息改成只有文字右对齐，或把长代码撑出的宽度当作正文宽度。",
      "Don't 在侧栏顶部恢复品牌块或个人工作区标题。",
      "Don't 为此界面加载外部字体或用新造标识替换现有品牌图片。",
      "Don't 将未使用的原型色值、12px 原型输入框圆角或欢迎页装饰文字升格为当前组件规范。"
    ]
  }
}
