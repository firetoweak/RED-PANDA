# Keep the real .env file private; it is ignored by Git.
# Only the provider selected by model.active needs its settings.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
# Alibaba Cloud Bailian (China) key.
QWEN_API_KEY=replace_with_your_bailian_api_key
# Local vLLM OpenAI-compatible server; VLLM_API_KEY only if started with --api-key.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=
