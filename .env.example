# Keep the real .env file private; it is ignored by Git.
# Shared by HelperMe as a bearer token and Ferro as MASTER_KEY.
FERRO_MASTER_KEY=fgw_replace_with_a_random_secret
# Provider credential for the deepseek target in ferro/config.yaml.
# Setup does not write this. Add it before starting Ferro.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
